{
  "overwrite": true,
  "dashboard": {
    "title": "API Overview",
    "uid": "api-overview",
    "tags": ["api", "overview"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Total API Requests",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(api_requests_total)",
            "legendFormat": "Total Requests"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Total Predictions",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(predictions_total)",
            "legendFormat": "Total Predictions"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Request Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(api_requests_total[5m])) by (endpoint, method)",
            "legendFormat": "{{endpoint}} {{method}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
      },
      {
        "id": 4,
        "title": "Response Time",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(api_request_duration_seconds_bucket[5m])) by (le, endpoint))",
            "legendFormat": "95th percentile - {{endpoint}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
      },
      {
        "id": 5,
        "title": "Request Status",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(api_requests_total[5m])) by (status)",
            "legendFormat": "Status {{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
      },
      {
        "id": 6,
        "title": "Prediction Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(predictions_total[5m])",
            "legendFormat": "Predictions/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
      },
      {
        "id": 7,
        "title": "Drift Alerts",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(drift_alerts_total)",
            "legendFormat": "Total Alerts"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 20}
      },
      {
        "id": 8,
        "title": "Active Users",
        "type": "stat",
        "targets": [
          {
            "expr": "active_users",
            "legendFormat": "Active Users"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 20}
      }
    ]
  }
}
